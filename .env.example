# Default Webflow API token (site token or OAuth token) used by every client that has no tokenEnv.
# Required scopes: sites:read sites:write pages:read pages:write cms:read cms:write custom_code:read custom_code:write
WEBFLOW_API_TOKEN=

# OAuth app credentials used by `npm run auth` (Workspace settings > Apps & integrations > Develop).
# WEBFLOW_CLIENT_ID=
# WEBFLOW_CLIENT_SECRET=

# Per-client tokens, referenced by "tokenEnv" in clients.json.
# WEBFLOW_TOKEN_GLOBEX=

# Optional overrides.
# CALLISTO_CLIENTS_FILE=clients.json
# CALLISTO_DATA_DIR=.callisto
# CALLISTO_DEFAULT_TOKEN_ENV=WEBFLOW_API_TOKEN
